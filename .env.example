#
# Which Firebase key set to use (build-time; restart dev server after change):
#   staging      → REACT_APP_FIREBASE_DEV_*
#   production   → REACT_APP_FIREBASE_PROD_*
#   development  → same as staging
# If unset: `npm start` defaults to staging; `npm run build` defaults to production.
#
# REACT_APP_APP_ENV=staging
#

# ── Firebase (UI “Dev”) — put in `.env.local` ─────────────────────────────────
# CRA `npm start` reads: `.env.development.local` → `.env.local` → `.env.development` → `.env`
REACT_APP_FIREBASE_DEV_API_KEY=
REACT_APP_FIREBASE_DEV_AUTH_DOMAIN=
REACT_APP_FIREBASE_DEV_PROJECT_ID=
REACT_APP_FIREBASE_DEV_STORAGE_BUCKET=
REACT_APP_FIREBASE_DEV_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_DEV_APP_ID=
# REACT_APP_FIREBASE_DEV_MEASUREMENT_ID=

# ── Firebase (UI “Prod”) — put in `.env.production` (and often also `.env.local`) ─────
# CRA `npm run build` reads: `.env.production.local` → `.env.local` → `.env.production` → `.env`
# IMPORTANT: `.env.production` is NOT loaded during `npm start`. For Dev+Prod Firebase while you
# develop, duplicate `REACT_APP_FIREBASE_PROD_*` into `.env.local` as well (see `src/config/appEnv.js`).
REACT_APP_FIREBASE_PROD_API_KEY=
REACT_APP_FIREBASE_PROD_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROD_PROJECT_ID=
REACT_APP_FIREBASE_PROD_STORAGE_BUCKET=
REACT_APP_FIREBASE_PROD_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_PROD_APP_ID=
# REACT_APP_FIREBASE_PROD_MEASUREMENT_ID=

# ── Optional: one shared Firebase project for BOTH toggles ────────────────────────────
# Fills any missing `_DEV_*` / `_PROD_*` field (same backing project in dev and prod mode).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# REACT_APP_FIREBASE_MEASUREMENT_ID=

# ── Other services (CRA needs REACT_APP_*, not VITE_*) ───────────────────────────────
# REACT_APP_CLOUDINARY_UNSIGNED_UPLOAD_PRESET=
# (legacy alias) REACT_APP_UNSIGNED_UPLOAD_PRESET=
# REACT_APP_PAYSTACK_PUBLIC_KEY=
# REACT_APP_API_BASE_URL=
